{
  "name": "lacuenta-scoreboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PWA marcador para el juego de cartas La Cuenta",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "verificar:offline": "npm run build && node scripts/verificar-offline.mjs",
    "iconos": "node scripts/generar-iconos.mjs",
    "fuentes": "node scripts/bajar-fuentes.mjs src/fuentes"
  },
  "dependencies": {
    "dexie": "4.4.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "fake-indexeddb": "6.2.5",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
